[Unit]
Description=minecraft server - matt

[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft/matt
ExecStart=java -jar ./server.jar
Restart=on-failure
ExecStop=/bin/sh -c '/usr/local/bin/mc-stop </opt/minecraft/matt/rcon_password'
SuccessExitStatus=0 1
ProtectHome=true
ProtectSystem=full
PrivateDevices=true
NoNewPrivileges=true
SyslogIdentifier=minecraft-matt

[Install]
WantedBy=default.target
