global:
  scrape_interval:     15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/node_exporter_alerts.yml
  - /etc/prometheus/custom_alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "localhost:9100"
{% for user in podman_containers | rejectattr('defunct', 'defined') | map(attribute='user') | unique %}
          - "localhost:{{ 9000 + (getent_passwd[user][1] | int) }}"
{% endfor %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']
