#!/bin/bash
set -euo pipefail
trap 's=$?; echo >&2 "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

# after all the heartache of trying to get machinectl/systemd-run working properly,
# I find out that the output from grype-everything.service is owned by user@XXX.service,
# so it goes to syslog instead of grype-everything's journal
run_as_user() {
    local username=$1
    shift
    local uid_number="$(getent passwd "$username" | awk -F : '{print $3}')"
    cd /home/$username
    (set -x; runuser --user="$username" -- env --ignore-environment HOME="/home/$username" XDG_RUNTIME_DIR="/run/user/$uid_number" "$@")
}

tmpdir="$(mktemp -d)"

(set -x; /usr/local/bin/grype db update)

{% for username in (podman_containers | rejectattr('defunct', 'defined') | map(attribute='user') | unique) %}
while read -r ref; do
    (set -x; /usr/local/bin/grype "podman:$ref" --output=json > "$tmpdir/grype_${ref//\//_}.json" || true)
done < <(run_as_user "{{ username }}" /usr/bin/podman ps --format json | jq -r '.[].Image' | sort -u)
{% endfor %}

{% for file in grype_files %}
(set -x; /usr/local/bin/grype "file:{{ file }}" --output=json > "$tmpdir/grype_{{ file | replace('/', '_') }}.json" || true)
{% endfor %}

{% for dir in grype_dirs %}
(set -x; /usr/local/bin/grype "dir:{{ dir }}" --output=json > "$tmpdir/grype_{{ dir | replace('/', '_') }}.json" || true)
{% endfor %}

rc=0
/usr/local/bin/grype_filter.py --risk-threshold=75 "$tmpdir"/*.json || rc=1
rm "$tmpdir"/grype_*.json
rmdir "$tmpdir"
exit "$rc"
